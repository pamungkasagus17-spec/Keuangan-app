<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aplikasi Keuangan Bersama</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
  <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans min-h-screen pb-10">

  <!-- Header -->
  <header class="bg-indigo-600 text-white p-4 shadow-md">
    <div class="max-w-md mx-auto flex justify-between items-center">
      <div>
        <h1 class="text-xl font-bold"><i class="fas fa-wallet mr-2"></i>Keuangan Bersama</h1>
        <p class="text-xs text-indigo-200" id="status-koneksi">Status: Memuat...</p>
      </div>
      <button onclick="toggleModal('modal-config')" class="bg-indigo-700 hover:bg-indigo-800 p-2 rounded-full text-sm">
        <i class="fas fa-cog"></i>
      </button>
    </div>
  </header>

  <main class="max-w-md mx-auto p-4 space-y-4">
    <!-- Ringkasan Saldo -->
    <div class="bg-white rounded-xl shadow p-5 border border-gray-100">
      <p class="text-sm text-gray-500 mb-1">Total Saldo Bersama</p>
      <h2 class="text-3xl font-extrabold text-indigo-600" id="total-saldo">Rp 0</h2>
      
      <div class="grid grid-cols-2 gap-4 mt-4 pt-4 border-t border-gray-100">
        <div>
          <p class="text-xs text-gray-400">Total Pemasukan</p>
          <p class="text-sm font-semibold text-green-600" id="total-masuk">+ Rp 0</p>
        </div>
        <div>
          <p class="text-xs text-gray-400">Total Pengeluaran</p>
          <p class="text-sm font-semibold text-red-500" id="total-keluar">- Rp 0</p>
        </div>
      </div>
    </div>

    <!-- Tombol Aksi -->
    <div class="grid grid-cols-2 gap-3">
      <button onclick="openForm('masuk')" class="bg-green-600 hover:bg-green-700 text-white font-medium py-2.5 px-4 rounded-lg shadow flex items-center justify-center gap-2">
        <i class="fas fa-arrow-down"></i> Pemasukan
      </button>
      <button onclick="openForm('keluar')" class="bg-red-500 hover:bg-red-600 text-white font-medium py-2.5 px-4 rounded-lg shadow flex items-center justify-center gap-2">
        <i class="fas fa-arrow-up"></i> Pengeluaran
      </button>
    </div>

    <!-- Riwayat Transaksi -->
    <div class="bg-white rounded-xl shadow p-4 border border-gray-100">
      <h3 class="font-bold text-gray-700 mb-3 flex justify-between items-center">
        <span>Riwayat Transaksi</span>
        <span class="text-xs text-indigo-600 bg-indigo-50 px-2 py-1 rounded" id="space-id-tag">Space: -</span>
      </h3>
      <div id="daftar-transaksi" class="space-y-3 max-h-80 overflow-y-auto pr-1">
        <p class="text-center text-sm text-gray-400 py-4">Belum ada transaksi</p>
      </div>
    </div>
  </main>

  <!-- Modal Pengaturan -->
  <div id="modal-config" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-xl max-w-sm w-full p-5 space-y-4 shadow-xl">
      <h3 class="font-bold text-lg text-gray-800">Pengaturan Ruang (Space ID)</h3>
      <p class="text-xs text-gray-500">Gunakan Space ID yang sama dengan teman Anda untuk berbagi data.</p>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">Space ID</label>
        <input type="text" id="input-space-id" placeholder="Contoh: kas-keluarga-123" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Anda</label>
        <input type="text" id="input-nama-user" placeholder="Contoh: Budi" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button onclick="toggleModal('modal-config')" class="px-4 py-2 text-xs font-medium text-gray-500 hover:bg-gray-100 rounded-lg">Batal</button>
        <button onclick="simpanConfig()" class="px-4 py-2 text-xs font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Hubungkan</button>
      </div>
    </div>
  </div>

  <!-- Modal Transaksi -->
  <div id="modal-transaksi" class="fixed inset-0 bg-black/50 hidden flex items-center justify-center p-4 z-50">
    <div class="bg-white rounded-xl max-w-sm w-full p-5 space-y-4 shadow-xl">
      <h3 class="font-bold text-lg text-gray-800" id="modal-title">Tambah Transaksi</h3>
      <form id="form-transaksi" onsubmit="tambahTransaksi(event)" class="space-y-3">
        <input type="hidden" id="tipe-transaksi" value="masuk">
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Keterangan</label>
          <input type="text" id="input-keterangan" required placeholder="Contoh: Beli Bensin / Gaji" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1">Jumlah (Rp)</label>
          <input type="number" id="input-nominal" required min="1" placeholder="50000" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="toggleModal('modal-transaksi')" class="px-4 py-2 text-xs font-medium text-gray-500 hover:bg-gray-100 rounded-lg">Batal</button>
          <button type="submit" class="px-4 py-2 text-xs font-medium bg-indigo-600 text-white rounded-lg hover:bg-indigo-700">Simpan</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const firebaseConfig = {
      databaseURL: "https://kas-bersama-default-rtdb.asia-southeast1.firebasedatabase.app"
    };

    if (!firebase.apps.length) {
      firebase.initializeApp(firebaseConfig);
    }
    const db = firebase.database();

    let currentSpace = localStorage.getItem('space_id') || 'kas-demo-123';
    let currentUser = localStorage.getItem('nama_user') || 'Pengguna';

    function formatRupiah(angka) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(angka);
    }

    function toggleModal(id) {
      document.getElementById(id).classList.toggle('hidden');
    }

    function openForm(tipe) {
      document.getElementById('tipe-transaksi').value = tipe;
      document.getElementById('modal-title').innerText = tipe === 'masuk' ? 'Tambah Pemasukan' : 'Tambah Pengeluaran';
      toggleModal('modal-transaksi');
    }

    function simpanConfig() {
      const space = document.getElementById('input-space-id').value.trim();
      const nama = document.getElementById('input-nama-user').value.trim();

      if (space) {
        currentSpace = space;
        currentUser = nama || 'Pengguna';
        localStorage.setItem('space_id', currentSpace);
        localStorage.setItem('nama_user', currentUser);
        toggleModal('modal-config');
        muatData();
      }
    }

    function tambahTransaksi(e) {
      e.preventDefault();
      const tipe = document.getElementById('tipe-transaksi').value;
      const keterangan = document.getElementById('input-keterangan').value;
      const nominal = parseInt(document.getElementById('input-nominal').value);

      db.ref(`spaces/${currentSpace}/transaksi`).push({
        tipe, keterangan, nominal, pencatat: currentUser,
        waktu: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
      });
      
      document.getElementById('form-transaksi').reset();
      toggleModal('modal-transaksi');
    }

    function hapusTransaksi(key) {
      if (confirm('Yakin hapus transaksi ini?')) {
        db.ref(`spaces/${currentSpace}/transaksi/${key}`).remove();
      }
    }

    function muatData() {
      document.getElementById('space-id-tag').innerText = `Space: ${currentSpace}`;
      document.getElementById('input-space-id').value = currentSpace;
      document.getElementById('input-nama-user').value = currentUser;

      db.ref(`spaces/${currentSpace}/transaksi`).on('value', (snapshot) => {
        document.getElementById('status-koneksi').innerText = 'Status: Terhubung';
        const data = snapshot.val();
        const container = document.getElementById('daftar-transaksi');
        container.innerHTML = '';

        let totalMasuk = 0, totalKeluar = 0;

        if (!data) {
          container.innerHTML = `<p class="text-center text-sm text-gray-400 py-4">Belum ada transaksi</p>`;
        } else {
          Object.keys(data).reverse().forEach(key => {
            const item = data[key];
            if (item.tipe === 'masuk') totalMasuk += item.nominal;
            if (item.tipe === 'keluar') totalKeluar += item.nominal;

            const isMasuk = item.tipe === 'masuk';
            container.innerHTML += `
              <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-lg border border-gray-100">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full ${isMasuk ? 'bg-green-100 text-green-600' : 'bg-red-100 text-red-600'} flex items-center justify-center text-xs">
                    <i class="fas ${isMasuk ? 'fa-arrow-down' : 'fa-arrow-up'}"></i>
                  </div>
                  <div>
                    <p class="text-sm font-semibold text-gray-800">${item.keterangan}</p>
                    <p class="text-[10px] text-gray-400">${item.pencatat} • ${item.waktu}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-bold ${isMasuk ? 'text-green-600' : 'text-red-500'}">
                    ${isMasuk ? '+' : '-'} ${formatRupiah(item.nominal)}
                  </span>
                  <button onclick="hapusTransaksi('${key}')" class="text-gray-300 hover:text-red-500 text-xs p-1">
                    <i class="fas fa-trash"></i>
                  </button>
                </div>
              </div>
            `;
          });
        }

        document.getElementById('total-masuk').innerText = `+ ${formatRupiah(totalMasuk)}`;
        document.getElementById('total-keluar').innerText = `- ${formatRupiah(totalKeluar)}`;
        document.getElementById('total-saldo').innerText = formatRupiah(totalMasuk - totalKeluar);
      });
    }

    muatData();
  </script>
</body>
</html>
